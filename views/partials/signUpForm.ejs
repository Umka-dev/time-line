<form
  action="/user/signup-login"
  method="POST"
  class="d-flex flex-column justify-content-center mb-4"
  style="max-width: 450px"
>
  <input name="email" type="email" placeholder="Email..." class="mb-3" />
  <input
    name="password"
    type="password"
    placeholder="Password..."
    class="mb-3"
  />
  <!-- Display errors -->
  <div class="d-flex flex-column justify-content-center"></div>

  <button class="btn btn-outline-primary">Create Account</button>
</form>
<div class="d-flex flex-column justify-content-center">
  <p class="text-success"><strong><%= result %></strong></p>
</div>
